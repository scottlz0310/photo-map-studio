<Window
    x:Class="PhotoMapStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:PhotoMapStudio.App.Views"
    Title="PhotoMapStudio">

    <Grid
        x:Name="RootLayout"
        Padding="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="HelpAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <StackPanel Spacing="4">
            <Button Content="ヘルプ (F1)" Click="HelpButton_Click" />
            <TextBlock
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="PhotoMapStudio" />
            <TextBlock
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Text="写真の撮影地点を中心とした地図画像を生成します。" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="0,16,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <views:FolderSettingsView
                        x:Name="FolderSettings"
                        DataContext="{x:Bind ViewModel}" />
                    <views:GenerationOptionsView DataContext="{x:Bind ViewModel}" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}"
                        Content="設定を保存" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.GenerateCommand}"
                        Content="一括生成" />
                    <TextBlock
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <sizers:GridSplitter
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                VerticalAlignment="Stretch" />

            <Grid Grid.Column="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <views:PreviewView
                    x:Name="Preview"
                    Grid.Row="0"
                    DataContext="{x:Bind ViewModel.Preview}" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <views:ProgressLogView DataContext="{x:Bind ViewModel}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
