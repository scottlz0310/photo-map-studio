<UserControl
    x:Class="PhotoMapStudio.App.Views.GenerationOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="生成オプション" />

        <Grid ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <NumberBox
                Grid.Row="0"
                Grid.Column="0"
                Header="幅 (px)"
                Minimum="1"
                SpinButtonPlacementMode="Compact"
                Value="{Binding Width, Mode=TwoWay}" />
            <NumberBox
                Grid.Row="0"
                Grid.Column="1"
                Header="高さ (px)"
                Minimum="1"
                SpinButtonPlacementMode="Compact"
                Value="{Binding Height, Mode=TwoWay}" />
            <NumberBox
                Grid.Row="1"
                Grid.Column="0"
                Header="ズームレベル"
                Minimum="{Binding MinimumZoom}"
                Maximum="{Binding MaximumZoom}"
                SpinButtonPlacementMode="Compact"
                Value="{Binding Zoom, Mode=TwoWay}" />
        </Grid>

        <ComboBox
            Header="タイルソース"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding TileSourceOptions}"
            SelectedItem="{Binding SelectedTileSource, Mode=TwoWay}" />

        <InfoBar IsOpen="{Binding HasTileUsageMessage}" IsClosable="False"
            Severity="Warning" Message="{Binding TileUsageMessage}" />

        <StackPanel Spacing="8" Visibility="{Binding IsCustomTileSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox
                Header="カスタム URL テンプレート"
                PlaceholderText="https://example.com/{z}/{x}/{y}.png"
                Text="{Binding CustomTileUrlTemplate, Mode=TwoWay}" />
            <TextBox
                Header="カスタム出典表示"
                PlaceholderText="地図データの出典"
                Text="{Binding CustomTileAttribution, Mode=TwoWay}" />
        </StackPanel>

        <ComboBox
            Header="ピン形状"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding PinKindOptions}"
            SelectedItem="{Binding SelectedPinKindChoice, Mode=TwoWay}" />

        <StackPanel Spacing="8" Visibility="{Binding IsCustomPinImageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ComboBox
                Header="アンカー基準点"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding PinAnchorOptions}"
                SelectedItem="{Binding SelectedPinAnchorChoice, Mode=TwoWay}" />
            <TextBox
                Header="カスタムピン画像"
                PlaceholderText="PNG ファイルのパス（未指定時は既定ピン）"
                Text="{Binding PinImagePath, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="8">
            <NumberBox
                Header="キャッシュ容量上限 (MB)"
                Minimum="10"
                Maximum="1048576"
                SpinButtonPlacementMode="Compact"
                Value="{Binding TileCacheSizeMb, Mode=TwoWay}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding TileCacheUsageText}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ClearTileCacheCommand}"
                    Content="キャッシュ消去" />
            </Grid>
        </StackPanel>

        <InfoBar
            IsOpen="{Binding HasValidationError}"
            IsClosable="False"
            Message="{Binding ValidationMessage}"
            Severity="Error" />
        <TextBlock
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            Text="{Binding SelectedTileSourceAttribution}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
