<UserControl
    x:Class="PhotoMapStudio.App.Views.ProgressLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="16"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="進捗ログ" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    Maximum="100"
                    Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIsIndeterminate}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding GenerationProgressPercentText}" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding ProgressMessage}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Command="{Binding CancelGenerationCommand}"
                    Content="キャンセル" />
            </Grid>
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding GenerationSummary}"
                TextWrapping="Wrap" />
            <TextBlock Text="{Binding GenerationDetails}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GenerationElapsedText}" />
            <TextBlock Text="{Binding Preview.StatusMessage}" TextWrapping="Wrap" />
            <Button Content="プレビューの読み込みをキャンセル" Command="{Binding Preview.CancelCommand}" />
            <TextBlock FontWeight="SemiBold" Text="スキップ・エラーの実行履歴" />
            <TextBlock Text="{Binding BatchHistoryMessage}" TextWrapping="Wrap" />
            <ComboBox
                HorizontalAlignment="Stretch"
                PlaceholderText="保存済みの実行を選択"
                ItemsSource="{Binding BatchHistories}"
                SelectedItem="{Binding SelectedBatchHistory, Mode=TwoWay}"
                DisplayMemberPath="DisplayName" />
            <Button Content="履歴を再読み込み" Command="{Binding LoadBatchHistoryCommand}" />
            <TextBlock Text="{Binding SelectedBatchHistory.InputFolderPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{Binding SelectedBatchHistory.SummaryText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedBatchHistory.EmptyMessage}" TextWrapping="Wrap" />
            <ListView MaxHeight="240" ItemsSource="{Binding SelectedBatchHistory.Issues}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="今回の進捗詳細" FontWeight="SemiBold" />
            <ListView
                MaxHeight="180"
                ItemsSource="{Binding GenerationLogs}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding StatusText}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Message}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
