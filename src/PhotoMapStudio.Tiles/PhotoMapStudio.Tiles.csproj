<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhotoMapStudio.Tiles</RootNamespace>
    <!--
      このパッケージの既定の版（公開済みの最新）。`tiles-vX.Y.Z` の公開は `-p:Version` で上書きする。
      PhotoMapStudio.Rendering を `dotnet pack` したとき、Rendering が宣言する Tiles への依存（>= この版）になるため、
      Tiles を公開したら、この値を公開した版へ更新する（docs/development/releasing-rendering.md）。
    -->
    <Version>0.1.0</Version>
    <!-- 公開 API の XML ドキュメントをパッケージへ含め、未記載（CS1591）をビルドエラーにする -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet パッケージ。描画（SkiaSharp）・WinUI・Windows App SDK に依存しない、タイルの取得・キャッシュ・デコード層 -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PhotoMapStudio.Tiles</PackageId>
    <Description>地図タイル（ラスター・ベクター MVT・PMTiles）の取得・キャッシュ・レート制御・デコード。描画には依存しない。</Description>
    <Authors>scottlz0310</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottlz0310/photo-map-studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottlz0310/photo-map-studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- nuget.org のパッケージのページに表示する README -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- タイル取得の HttpClient 管理（IHttpClientFactory） -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
  </ItemGroup>

</Project>
